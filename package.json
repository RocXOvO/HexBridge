{
  "name": "hexbridge",
  "version": "0.1.67",
  "description": "A read-only ARAM Mayhem companion for League of Legends.",
  "author": "HexBridge contributors",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:ocr": "node scripts/ocr-smoke.mjs",
    "test:ocr:fixture": "node scripts/ocr-real-fixture.mjs",
    "test:bridge": "npm run build && npm run verify:preload && node scripts/electron-bridge-smoke.mjs",
    "test:bridge:packaged": "node scripts/electron-bridge-smoke.mjs release/win-unpacked/HexBridge.exe",
    "test:ui": "npm run build && node scripts/electron-ui-smoke.mjs",
    "test:ui:packaged": "node scripts/electron-ui-smoke.mjs release/win-unpacked/HexBridge.exe",
    "test:update:packaged": "node scripts/electron-update-smoke.mjs release/win-unpacked/HexBridge.exe",
    "test:update:public": "node scripts/verify-public-update-channel.mjs",
    "test:update:legacy": "node scripts/verify-legacy-update-channel.mjs",
    "test:update:public:packaged": "node scripts/electron-public-update-smoke.mjs release/win-unpacked/HexBridge.exe",
    "test:watch": "vitest",
    "lint": "eslint .",
    "ocr:models": "node scripts/download-ocr-models.mjs",
    "icons": "node scripts/generate-icon.mjs",
    "verify:icon": "node scripts/verify-icon.mjs",
    "checksums": "node scripts/checksums.mjs",
    "verify:update-metadata": "node scripts/verify-update-metadata.mjs",
    "render:update-channel": "node scripts/render-update-channel.mjs",
    "preflight:release": "node scripts/preflight-stable-release.mjs",
    "publish:release": "node scripts/publish-stable-release.mjs",
    "prune:releases": "node scripts/prune-stable-releases.mjs",
    "publish:update-channel": "node scripts/publish-update-channel.mjs",
    "verify:preload": "node scripts/verify-preload-bundle.mjs",
    "clean:release": "node scripts/clean-local-release.mjs",
    "verify:release-retention": "node scripts/verify-release-retention.mjs",
    "pack:win": "npm run clean:release && npm run icons && npm run verify:icon && npm run verify:release-retention && npm run build && npm run verify:preload && electron-builder --win nsis zip --x64 --publish never && npm run verify:update-metadata",
    "pack:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "onnxruntime-node": "1.27.0",
    "paddleocr": "1.2.0",
    "sharp": "0.35.3",
    "vue": "3.5.41",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.8.0",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    }
  },
  "build": {
    "appId": "dev.hexbridge.app",
    "productName": "HexBridge",
    "artifactName": "HexBridge-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/RocXOvO/HexBridge/update-channel/v2/",
        "useMultipleRangeRequest": false
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE.md"
    ],
    "extraResources": [
      {
        "from": "resources/paddleocr",
        "to": "paddleocr",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HexBridge"
    }
  }
}
